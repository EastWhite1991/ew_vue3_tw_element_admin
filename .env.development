# 环境变量
ENV = 'development'

# 只在开发模式中被载入
VITE_CLI_PORT = 5173

# 服务器端口
VITE_SERVER_PORT = 8888

# 网站根目录
VITE_PUBLIC_PATH = ./

# 是否开启 mock
VITE_USE_MOCK = false

# 是否开启控制台打印 mock 请求信息
VITE_LOGGER_MOCK = false

# 是否删除console
VITE_DROP_CONSOLE = false

# 接口prefix
VITE_BASE_API = /api

# 文件上传接口prefix
VITE_FILE_API = /api

# 后端接口url
VITE_BASE_PATH = http://127.0.0.1

# 跨域代理，可以配置多个，请注意不要换行
VITE_PROXY = [["/api","http://127.0.0.1:8888"]]

# API 接口地址
VITE_GLOB_API_URL =

# 接口前缀
VITE_GLOB_API_URL_PREFIX = /api

# 文件上传地址
VITE_GLOB_UPLOAD_URL=https://4025308b-e06d-4365-aee4-b7fd788cbf4e.mock.pstmn.io/

# 文件前缀地址
VITE_GLOB_FILE_URL=

# 
VITE_POSITION = close

# 编辑器
VITE_EDITOR = vscode